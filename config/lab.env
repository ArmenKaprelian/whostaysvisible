# Lab environment: roots and numeric limits. Sourced by every launcher.
# Everything outside $LAB is read-only to the lab; see README.md.
ROOT="/home/armen/Documents/PhD/CGU/Dissertation/00 Full Dissertation"
PROG="$ROOT/programming"
LATEX="$ROOT/LaTeX"
LAB="$ROOT/Claude Code/current/dataviz-lab"
RENV_LIB="$PROG/renv/library/linux-ubuntu-resolute/R-4.5/x86_64-pc-linux-gnu"
USER_LIB="$HOME/R/x86_64-pc-linux-gnu-library/4.5"

# Scratch: disk-backed, no spaces (R rejects TMPDIR paths with spaces).
LAB_SCRATCH_PARENT=/var/tmp
LAB_SCRATCH_MIN_GIB=10

# Guarded job (scripts/lab-run.sh): systemd transient unit.
LAB_UNIT=claude-dataviz-lab
LAB_MEMORY_HIGH=2G
LAB_MEMORY_MAX=3G
LAB_SWAP_MAX=256M
LAB_CPU_QUOTA=400%
LAB_TASKS_MAX=512
LAB_MEMAVAILABLE_MIN_MIB=5120
LAB_SWAPFREE_MIN_MIB=1024
# --max 4G option for one named heavy query only.
LAB_MEMORY_HIGH_BIG=3G
LAB_MEMORY_MAX_BIG=4G
LAB_MEMAVAILABLE_MIN_MIB_BIG=6144

# Watcher.
LAB_WATCH_INTERVAL=5
LAB_WATCH_FLOOR_MIB=1536
LAB_WATCH_SWAP_FLOOR_MIB=512

# DuckDB settings applied by R/lab-duck.R (project variables, not native settings).
LAB_DUCKDB_MEMORY_LIMIT=1536MB
LAB_DUCKDB_THREADS=2
LAB_DUCKDB_MAX_TEMP=5GB

# Codex's own guard, probed read-only.
CODEX_UNIT=rfsd-local-data
CODEX_LOCK="$PROG/output/local-execution/job.lock"
