  "sql": "SELECT 2012 AS year, count(*) AS n, count(*) FILTER (WHERE located) AS n_located, count(*) FILTER (WHERE original_available = 1) AS n_available,\n                               count(*) FILTER (WHERE located AND original_available = 1) AS n_located_available, count(*) FILTER (WHERE registered_year_end) AS n_registered,\n                               count(*) FILTER (WHERE located AND registered_year_end) AS n_located_registered, count(*) FILTER (WHERE no_payload_row) AS n_without_payload_row FROM (\n  WITH r AS (SELECT source_row, original_available, registered_year_end, member_sanctioned FROM read_parquet(['/home/armen/Documents/PhD/CGU/Dissertation/00 Full Dissertation/programming/data/derived/task4-foundation-lightning-20261005/foundation/registry/year=2012/generation-10b9d6d30988/registry.parquet']) WHERE eligible_raw = 1),\n       p AS (SELECT source_row, lon, lat, TRUE AS has_payload FROM read_parquet(['/home/armen/Documents/PhD/CGU/Dissertation/00 Full Dissertation/programming/data/derived/task4-foundation-lightning-20261005/foundation/source/year=2012/generation-10b9d772e3e80/raw-payload.parquet'])),\n       j AS (SELECT r.*, p.lon, p.lat, coalesce(p.has_payload, FALSE) AS has_payload FROM r LEFT JOIN p USING (source_row)),\n       a AS (SELECT *, coalesce(isfinite(lon) AND isfinite(lat) AND lon BETWEEN -180 AND 180 AND lat BETWEEN -90 AND 90, false) AS bounds_valid,\n                    lat * pi() / 180 AS phi, ((lon - 100 + 180) - 360 * floor((lon - 100 + 180) / 360) - 180) * pi() / 180 AS dl FROM j),\n       b AS (SELECT *, 1 + sin(pi() / 3) * sin(phi) + cos(pi() / 3) * cos(phi) * cos(dl) AS den FROM a)\n  SELECT original_available, registered_year_end, member_sanctioned, NOT has_payload AS no_payload_row, coalesce(bounds_valid AND den > 1e-12, false) AS located,\n         CASE WHEN bounds_valid AND den > 1e-12 THEN 6371 * sqrt(2 / den) * cos(phi) * sin(dl) END AS x_km,\n         CASE WHEN bounds_valid AND den > 1e-12 THEN 6371 * sqrt(2 / den) * (cos(pi() / 3) * sin(phi) - sin(pi() / 3) * cos(phi) * cos(dl)) END AS y_km\n  FROM b)",
