  "sql": "\nWITH r AS (\n  SELECT inn_key, year, CASE WHEN registered_year_end = false THEN 'X'\n                   WHEN eligible_raw = 1 AND original_available = 1 THEN 'A'\n                   WHEN eligible_raw = 1 AND original_available = 0 AND registered_year_end THEN 'N'\n                   ELSE 'O' END AS state\n  FROM read_parquet(['/home/armen/Documents/PhD/CGU/Dissertation/00 Full Dissertation/programming/data/derived/task4-foundation-lightning-20261005/foundation/registry/year=2019/generation-10b9d382646ef/registry.parquet', '/home/armen/Documents/PhD/CGU/Dissertation/00 Full Dissertation/programming/data/derived/task4-foundation-lightning-20261005/foundation/registry/year=2020/generation-10b9d3c8381fa/registry.parquet', '/home/armen/Documents/PhD/CGU/Dissertation/00 Full Dissertation/programming/data/derived/task4-foundation-lightning-20261005/foundation/registry/year=2021/generation-10b9d5d363d92/registry.parquet', '/home/armen/Documents/PhD/CGU/Dissertation/00 Full Dissertation/programming/data/derived/task4-foundation-lightning-20261005/foundation/registry/year=2022/generation-10b9d826b541/registry.parquet', '/home/armen/Documents/PhD/CGU/Dissertation/00 Full Dissertation/programming/data/derived/task4-foundation-lightning-20261005/foundation/registry/year=2023/generation-10b9dafdc90e/registry.parquet', '/home/armen/Documents/PhD/CGU/Dissertation/00 Full Dissertation/programming/data/derived/task4-foundation-lightning-20261005/foundation/registry/year=2024/generation-10b9d1db9b6af/registry.parquet']) WHERE inn_key IS NOT NULL AND identity_consistent),\nu AS (SELECT DISTINCT inn_key FROM r WHERE year = 2019 AND state IN ('A', 'N')),\np AS (SELECT r.inn_key, coalesce(max(CASE WHEN year = 2019 THEN state END), '-') || coalesce(max(CASE WHEN year = 2020 THEN state END), '-') || coalesce(max(CASE WHEN year = 2021 THEN state END), '-') || coalesce(max(CASE WHEN year = 2022 THEN state END), '-') || coalesce(max(CASE WHEN year = 2023 THEN state END), '-') || coalesce(max(CASE WHEN year = 2024 THEN state END), '-') AS history FROM r JOIN u USING (inn_key) GROUP BY r.inn_key)\nSELECT history, count(*) AS firms FROM p GROUP BY 1 ORDER BY 2 DESC",
