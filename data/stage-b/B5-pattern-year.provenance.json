  "sql": "\nSELECT year, coalesce(cast(member_sanctioned AS varchar), '?') || coalesce(cast(member_putin_decree AS varchar), '?') || coalesce(cast(member_residents AS varchar), '?') || coalesce(cast(member_strateg_government AS varchar), '?') || coalesce(cast(member_strateg_putin AS varchar), '?') AS pattern,\n       count(*) FILTER (WHERE eligible_raw = 1) AS eligible_rows,\n       count(*) FILTER (WHERE eligible_raw = 1 AND original_available = 1) AS eligible_available,\n       count(*) FILTER (WHERE eligible_raw = 1 AND registered_year_end) AS eligible_registered,\n       count(*) FILTER (WHERE eligible_raw = 1 AND registered_year_end AND original_available = 1) AS registered_available\nFROM read_parquet(['/home/armen/Documents/PhD/CGU/Dissertation/00 Full Dissertation/programming/data/derived/task4-foundation-lightning-20261005/foundation/registry/year=2011/generation-10b9d66eb2efe/registry.parquet', '/home/armen/Documents/PhD/CGU/Dissertation/00 Full Dissertation/programming/data/derived/task4-foundation-lightning-20261005/foundation/registry/year=2012/generation-10b9d6d30988/registry.parquet', '/home/armen/Documents/PhD/CGU/Dissertation/00 Full Dissertation/programming/data/derived/task4-foundation-lightning-20261005/foundation/registry/year=2013/generation-10b9d5bf04844/registry.parquet', '/home/armen/Documents/PhD/CGU/Dissertation/00 Full Dissertation/programming/data/derived/task4-foundation-lightning-20261005/foundation/registry/year=2014/generation-10b9d19df45f2/registry.parquet', '/home/armen/Documents/PhD/CGU/Dissertation/00 Full Dissertation/programming/data/derived/task4-foundation-lightning-20261005/foundation/registry/year=2015/generation-10b9d258740eb/registry.parquet', '/home/armen/Documents/PhD/CGU/Dissertation/00 Full Dissertation/programming/data/derived/task4-foundation-lightning-20261005/foundation/registry/year=2016/generation-10b9d3e0b028a/registry.parquet', '/home/armen/Documents/PhD/CGU/Dissertation/00 Full Dissertation/programming/data/d